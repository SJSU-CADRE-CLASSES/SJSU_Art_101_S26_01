{
  "version": 1,
  "controls": [
    { "id": "focal-depth",   "type": "range", "label": "Focal Depth",       "uniform": "uFocalDepth",      "min": 0.0,  "max": 25.0, "step": 0.1, "default": 0.5  },
    { "id": "coc",           "type": "range", "label": "Circle of Confusion","uniform": "uCircleOfConfusion","min": 0.1,  "max": 3.0,  "step": 0.05,"default": 3.0  },
    { "id": "bump",          "type": "range", "label": "Wall Noise Bump",    "uniform": "uBumpIntensity",   "min": 0.0,  "max": 2.0,  "step": 0.01,"default": 0.5  },
    { "id": "noise-density", "type": "range", "label": "Noise Density",      "uniform": "uNoiseDensity",    "min": 1.0,  "max": 25.0, "step": 0.1, "default": 25.0 },
    { "id": "noise-speed",   "type": "range", "label": "Noise Speed",        "uniform": "uNoiseSpeed",      "min": 0.0,  "max": 10.0, "step": 0.1, "default": 10.0 },
    { "id": "light-speed",   "type": "range", "label": "Light Speed",        "uniform": "uLightSpeed",      "min": 0.1,  "max": 5.0,  "step": 0.1, "default": 1.0  },
    { "id": "cam-dolly",     "type": "range", "label": "Camera Dolly Speed", "uniform": "uCameraDolly",     "min": 0.0,  "max": 10.0, "step": 0.1, "default": 2.0  },
    { "id": "cam-roll",      "type": "range", "label": "Camera Roll Speed",  "uniform": "uCameraRollSpeed", "min": -5.0, "max": 5.0,  "step": 0.1, "default": 0.0  }
  ]
}
