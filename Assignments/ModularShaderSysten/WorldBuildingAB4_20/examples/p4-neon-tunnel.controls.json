{
  "version": 1,
  "controls": [
    { "id": "speed",    "type": "range", "label": "Flight Speed",       "uniform": "uSpeed",       "min": 0.0, "max": 2.0,  "step": 0.01, "default": 1.0   },
    { "id": "hue",      "type": "range", "label": "Color Hue (Degrees)","uniform": "uHue",         "min": 0.0, "max": 360.0,"step": 1.0,  "default": 288.0 },
    { "id": "grid",     "type": "range", "label": "Architecture Scale", "uniform": "uGridDensity", "min": 0.1, "max": 3.0,  "step": 0.01, "default": 1.0   },
    { "id": "exposure", "type": "range", "label": "Exposure",           "uniform": "uExposure",    "min": 0.1, "max": 5.0,  "step": 0.1,  "default": 0.1   },
    { "id": "decay",    "type": "range", "label": "Radial Decay",       "uniform": "uDecay",       "min": 0.5, "max": 1.0,  "step": 0.01, "default": 0.65  },
    { "id": "density",  "type": "range", "label": "Radial Density",     "uniform": "uDensity",     "min": 0.0, "max": 1.0,  "step": 0.01, "default": 0.30  },
    { "id": "weight",   "type": "range", "label": "Radial Weight",      "uniform": "uWeight",      "min": 0.0, "max": 1.0,  "step": 0.01, "default": 0.60  }
  ]
}
