# Supabase: Project Settings → API (recommended for local dev)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: same values without NEXT_PUBLIC — read at runtime on the server (e.g. Vercel)
# if you prefer not to rely on build-time inlining for the login form:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
