<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>February 2026 · Week of Feb 8–14</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #fff5f7;
      --card: #ffffff;
      --card-soft: #fef9fb;
      --accent: #ff9eb5;
      --accent-soft: #ffb8c9;
      --mint: #b8e6d5;
      --mint-soft: #e0f5ee;
      --lavender: #d4c5f9;
      --lavender-soft: #efe9fd;
      --text: #5c4a5a;
      --text-muted: #9b8a99;
      --border: #f0dde4;
      --highlight-week: #ffe4ec;
      --shadow: rgba(255, 158, 181, 0.15);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Nunito', sans-serif;
      background: var(--bg);
      background-image: radial-gradient(ellipse at 20% 20%, var(--lavender-soft) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 80%, var(--mint-soft) 0%, transparent 50%);
      color: var(--text);
      min-height: 100vh;
      padding: 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .header {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .header h1 {
      font-weight: 700;
      font-size: 1.6rem;
      color: var(--text);
    }

    .header p {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-top: 0.25rem;
    }

    /* Instructions tab */
    .instructions-wrap {
      position: fixed;
      top: 1rem;
      right: 1rem;
      z-index: 20;
    }

    .instructions-trigger {
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--accent);
      padding: 0.5rem 0.75rem;
      border-radius: 2rem;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.85rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      box-shadow: 0 2px 12px var(--shadow);
      transition: background 0.2s, transform 0.15s;
    }

    .instructions-trigger:hover {
      background: var(--highlight-week);
      transform: scale(1.03);
    }

    .instructions-panel {
      position: absolute;
      top: 100%;
      right: 0;
      margin-top: 0.5rem;
      width: 260px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 1rem;
      box-shadow: 0 8px 24px var(--shadow);
      display: none;
    }

    .instructions-panel.open {
      display: block;
    }

    .instructions-panel h3 {
      font-size: 0.95rem;
      margin-bottom: 0.5rem;
      color: var(--accent);
    }

    .instructions-panel p, .instructions-panel ul {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .instructions-panel ul {
      margin-top: 0.5rem;
      padding-left: 1.2rem;
      line-height: 1.6;
    }

    /* Calendar – full month style, large and centered */
    .calendar-container {
      width: 100%;
      max-width: min(640px, 90vw);
      margin: 0 auto;
      background: var(--card);
      border-radius: 1.5rem;
      border: 1px solid var(--border);
      box-shadow: 0 8px 32px var(--shadow);
      padding: 1.75rem;
      position: relative;
    }

    .calendar-month {
      text-align: center;
      font-weight: 700;
      font-size: 1.5rem;
      color: var(--text);
      margin-bottom: 1.25rem;
    }

    .calendar-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 6px;
      position: relative;
    }

    .calendar-weekday {
      text-align: center;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      padding: 0.5rem 0;
    }

    .day-cell {
      aspect-ratio: 1;
      max-width: 72px;
      margin: 0 auto;
      width: 100%;
      background: var(--card-soft);
      border-radius: 0.75rem;
      border: 1px solid transparent;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text-muted);
      transition: border-color 0.2s, background 0.2s, transform 0.15s;
    }

    .day-cell.other-month {
      visibility: hidden;
    }

    .day-cell.week-highlight {
      background: var(--highlight-week);
      color: var(--text);
      cursor: pointer;
      border-color: var(--border);
    }

    .day-cell.week-highlight:hover {
      background: var(--accent-soft);
      border-color: var(--accent);
      transform: scale(1.08);
    }

    .day-cell.week-highlight.selected {
      border-color: var(--accent);
      background: var(--accent-soft);
      box-shadow: 0 0 0 2px var(--accent);
    }

    .day-cell.week-highlight a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      color: inherit;
      text-decoration: none;
    }

    .week-total-link {
      display: inline-block;
      margin-top: 2rem;
      padding: 0.75rem 1.5rem;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 2rem;
      color: var(--accent);
      font-family: inherit;
      font-size: 1rem;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 2px 12px var(--shadow);
      transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    }
    .week-total-link:hover {
      background: var(--highlight-week);
      transform: scale(1.03);
      box-shadow: 0 4px 16px var(--shadow);
    }

    /* Avatar layer */
    .avatar-layer {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .avatar-wrapper {
      position: absolute;
      width: 56px;
      height: 56px;
      left: 0;
      top: 0;
      transition: left 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), top 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      display: flex;
      justify-content: center;
      align-items: center;
      transform: translate(-50%, -50%);
    }

    .avatar {
      width: 56px;
      height: 56px;
    }

    .avatar svg {
      width: 100%;
      height: 100%;
      filter: drop-shadow(0 3px 8px rgba(255, 158, 181, 0.35));
    }
  </style>
</head>
<body>
  <div class="instructions-wrap">
    <button type="button" class="instructions-trigger" id="instructionsBtn" aria-expanded="false">
      <span aria-hidden="true">?</span> Instructions
    </button>
    <div class="instructions-panel" id="instructionsPanel" role="region" aria-label="How to use">
      <h3>Scrapbook week</h3>
      <p>Click any date in the highlighted week (Feb 8–14) to open that day's scrapbook page.</p>
      <ul>
        <li>Each date links to its own scrapbook page</li>
        <li>See purchases as paper notes, or “No money spent!” on Feb 8</li>
      </ul>
    </div>
  </div>

  <header class="header">
    <h1>February 2026</h1>
    <p>Click a date in the highlighted week to open that day's scrapbook</p>
  </header>

  <main class="calendar-container" id="calendarContainer">
    <div class="calendar-month">February 2026</div>
    <div class="calendar-grid" id="calendarGrid">
      <!-- Weekday headers -->
      <div class="calendar-weekday">Sun</div>
      <div class="calendar-weekday">Mon</div>
      <div class="calendar-weekday">Tue</div>
      <div class="calendar-weekday">Wed</div>
      <div class="calendar-weekday">Thu</div>
      <div class="calendar-weekday">Fri</div>
      <div class="calendar-weekday">Sat</div>
      <!-- Feb 2026: 1st is Sunday. Empty cells for alignment not needed. -->
      <!-- Row 1: 1-7 -->
      <div class="day-cell" data-date="2026-02-01">1</div>
      <div class="day-cell" data-date="2026-02-02">2</div>
      <div class="day-cell" data-date="2026-02-03">3</div>
      <div class="day-cell" data-date="2026-02-04">4</div>
      <div class="day-cell" data-date="2026-02-05">5</div>
      <div class="day-cell" data-date="2026-02-06">6</div>
      <div class="day-cell" data-date="2026-02-07">7</div>
      <!-- Row 2: 8-14 (highlighted week) -->
      <div class="day-cell week-highlight" data-index="0" data-date="2026-02-08"><a href="pages/day-08.html">8</a></div>
      <div class="day-cell week-highlight" data-index="1" data-date="2026-02-09"><a href="pages/day-09.html">9</a></div>
      <div class="day-cell week-highlight" data-index="2" data-date="2026-02-10"><a href="pages/day-10.html">10</a></div>
      <div class="day-cell week-highlight" data-index="3" data-date="2026-02-11"><a href="pages/day-11.html">11</a></div>
      <div class="day-cell week-highlight" data-index="4" data-date="2026-02-12"><a href="pages/day-12.html">12</a></div>
      <div class="day-cell week-highlight" data-index="5" data-date="2026-02-13"><a href="pages/day-13.html">13</a></div>
      <div class="day-cell week-highlight" data-index="6" data-date="2026-02-14"><a href="pages/day-14.html">14</a></div>
      <!-- Row 3: 15-21 -->
      <div class="day-cell" data-date="2026-02-15">15</div>
      <div class="day-cell" data-date="2026-02-16">16</div>
      <div class="day-cell" data-date="2026-02-17">17</div>
      <div class="day-cell" data-date="2026-02-18">18</div>
      <div class="day-cell" data-date="2026-02-19">19</div>
      <div class="day-cell" data-date="2026-02-20">20</div>
      <div class="day-cell" data-date="2026-02-21">21</div>
      <!-- Row 4: 22-28 -->
      <div class="day-cell" data-date="2026-02-22">22</div>
      <div class="day-cell" data-date="2026-02-23">23</div>
      <div class="day-cell" data-date="2026-02-24">24</div>
      <div class="day-cell" data-date="2026-02-25">25</div>
      <div class="day-cell" data-date="2026-02-26">26</div>
      <div class="day-cell" data-date="2026-02-27">27</div>
      <div class="day-cell" data-date="2026-02-28">28</div>
    </div>

    <div class="avatar-layer" aria-hidden="true">
      <div class="avatar-wrapper" id="avatarWrapper">
        <div class="avatar" title="Avatar">
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- hair (back, longer) -->
            <ellipse cx="32" cy="32" rx="21" ry="28" fill="#6B5344"/>
            <!-- face -->
            <circle cx="32" cy="30" r="18" fill="#FFE4D4"/>
            <!-- blush -->
            <ellipse cx="18" cy="34" rx="4" ry="3" fill="#FFB8C9" opacity="0.6"/>
            <ellipse cx="46" cy="34" rx="4" ry="3" fill="#FFB8C9" opacity="0.6"/>
            <!-- eyes (cute dots) -->
            <circle cx="23" cy="28" r="2.5" fill="#5c4a5a"/>
            <circle cx="41" cy="28" r="2.5" fill="#5c4a5a"/>
            <!-- glasses (square frames with nose bridge) -->
            <path d="M17 23 L29 23 L29 33 L17 33 Z" fill="none" stroke="#5c4a5a" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M29 23 Q32 26 35 23" fill="none" stroke="#5c4a5a" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M35 23 L47 23 L47 33 L35 33 Z" fill="none" stroke="#5c4a5a" stroke-width="1.5" stroke-linejoin="round"/>
            <!-- smile -->
            <path d="M23 36 Q32 41 41 36" stroke="#e8a0a0" stroke-width="1.5" stroke-linecap="round" fill="none"/>
            <!-- side hair (longer locks) -->
            <path d="M12 36 Q8 50 14 58 Q18 54 16 38 Z" fill="#6B5344"/>
            <path d="M52 36 Q56 50 50 58 Q46 54 48 38 Z" fill="#6B5344"/>
          </svg>
        </div>
      </div>
    </div>
  </main>
  <a href="pages/weekly-total.html" class="week-total-link">See weekly total ✨</a>

  <script>
    (function () {
      const container = document.getElementById('calendarContainer');
      const grid = document.getElementById('calendarGrid');
      const avatarWrapper = document.getElementById('avatarWrapper');
      const cells = grid.querySelectorAll('.day-cell.week-highlight');
      const instructionsBtn = document.getElementById('instructionsBtn');
      const instructionsPanel = document.getElementById('instructionsPanel');

      function positionAvatar(index) {
        const cell = cells[index];
        if (!cell) return;
        const containerRect = container.getBoundingClientRect();
        const cellRect = cell.getBoundingClientRect();
        const centerX = cellRect.left - containerRect.left + cellRect.width / 2;
        const centerY = cellRect.top - containerRect.top + cellRect.height / 2;
        avatarWrapper.style.left = centerX + 'px';
        avatarWrapper.style.top = centerY + 'px';
      }

      function setSelected(index) {
        cells.forEach(function (cell, i) {
          cell.classList.toggle('selected', i === index);
        });
      }

      function handleCellClick(e) {
        const cell = e.currentTarget;
        const index = parseInt(cell.getAttribute('data-index'), 10);
        if (isNaN(index)) return;
        positionAvatar(index);
        setSelected(index);
      }

      function handleLinkClick(e) {
        const link = e.currentTarget;
        const cell = link.closest('.day-cell.week-highlight');
        if (!cell) return;
        const index = parseInt(cell.getAttribute('data-index'), 10);
        if (isNaN(index)) return;
        e.preventDefault();
        positionAvatar(index);
        setSelected(index);
        setTimeout(function () {
          window.location.href = link.getAttribute('href');
        }, 350);
      }

      cells.forEach(function (cell) {
        cell.addEventListener('click', handleCellClick);
        const link = cell.querySelector('a');
        if (link) link.addEventListener('click', handleLinkClick);
      });

      instructionsBtn.addEventListener('click', function () {
        const open = instructionsPanel.classList.toggle('open');
        instructionsBtn.setAttribute('aria-expanded', open);
      });

      document.addEventListener('click', function (e) {
        if (!instructionsPanel.contains(e.target) && !instructionsBtn.contains(e.target)) {
          instructionsPanel.classList.remove('open');
          instructionsBtn.setAttribute('aria-expanded', 'false');
        }
      });

      positionAvatar(0);
      setSelected(0);
    })();
  </script>
</body>
</html>